			VAR _k2 = IF(ISBLANK(_r2) || ISBLANK(_c2), "#6B7682", IF(ABS(_d2) < 0.0005, "#6B7682", IF(_d2 >= 0, "#16703F", "#B42318")))
			VAR _e = _d0
