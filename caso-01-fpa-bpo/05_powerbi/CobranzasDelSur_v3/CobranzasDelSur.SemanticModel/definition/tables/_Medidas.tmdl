/// Todas las medidas del modelo, ordenadas en carpetas.
table _Medidas
	lineageTag: bb65abf5-f499-41d4-bbc4-f604160e66b0

	/// Último mes con datos reales (índice de Calendario), sin importar los filtros. Hoy: septiembre 2025.
	measure 'Índice de corte' =
			VAR meses =
			    CALCULATETABLE(VALUES(Resultado[mes]), REMOVEFILTERS(), Escenario[esc] = "REAL")
			RETURN
			    CALCULATE(MAX(Calendario[indice]), REMOVEFILTERS(), TREATAS(meses, Calendario[mes]))
		formatString: #,##0
		displayFolder: 0. Período
		lineageTag: e319de0c-3fa3-4be9-85f4-0e31f0e21dd0

	/// Mes de análisis: el elegido con los botones de mes o, si no hay ninguno, el último mes real.
	measure 'Índice hasta' =
			VAR elegido = SELECTEDVALUE(MesAnalisis[indice])
			RETURN IF(ISBLANK(elegido), [Índice de corte], elegido)
		formatString: #,##0
		displayFolder: 0. Período
		lineageTag: 02d1a3df-d281-4b5a-bccf-a222ebf2b231

	/// Primer mes del período: el mismo mes (vista Mes) o enero de ese año (vista Acumulado).
	measure 'Índice desde' =
			VAR h = [Índice hasta]
			VAR acumulado = SELECTEDVALUE(Vista[Vista], "Mes") = "Acumulado"
			VAR mesDelAnio = CALCULATE(MAX(Calendario[mes_num]), REMOVEFILTERS(Calendario), Calendario[indice] = h)
			RETURN IF(acumulado, h - mesDelAnio + 1, h)
		formatString: #,##0
		displayFolder: 0. Período
		lineageTag: 1e5b3772-4650-408e-bde1-b03d0a3000f4

	/// Año del mes de análisis. Las series mensuales muestran ese año.
	measure 'Año de análisis' =
			VAR h = [Índice hasta]
			RETURN CALCULATE(MAX(Calendario[anio]), REMOVEFILTERS(Calendario), Calendario[indice] = h)
		formatString: 0
		displayFolder: 0. Período
		lineageTag: ff0be14d-e202-43a1-8190-91711a8725f4

	/// Período corto (sep-25 o ene-25 a sep-25), para títulos.
	measure Período =
			VAR h = [Índice hasta]
			VAR d = [Índice desde]
			VAR txtH = CALCULATE(SELECTEDVALUE(Calendario[Mes año]), REMOVEFILTERS(Calendario), Calendario[indice] = h)
			VAR txtD = CALCULATE(SELECTEDVALUE(Calendario[Mes año]), REMOVEFILTERS(Calendario), Calendario[indice] = d)
			RETURN IF(d = h, txtH, txtD & " a " & txtH)
		displayFolder: 0. Período
		lineageTag: 38cbc981-ab73-4712-a423-e8fa3046f178

	/// Período en palabras (Septiembre 2025 o Enero a septiembre 2025), para el encabezado.
	measure 'Período largo' =
			VAR h = [Índice hasta]
			VAR d = [Índice desde]
			VAR fh = CALCULATE(MAX(Calendario[Fecha]), REMOVEFILTERS(Calendario), Calendario[indice] = h)
			VAR mesTxt = FORMAT(fh, "mmmm", "es-AR")
			VAR mesCap = UPPER(LEFT(mesTxt, 1)) & MID(mesTxt, 2, 20)
			RETURN IF(d = h, mesCap & " " & YEAR(fh), "Enero a " & mesTxt & " " & YEAR(fh))
		displayFolder: 0. Período
		lineageTag: 3d6bfd53-445d-4963-a30e-b2b79bfc1d95

	/// Último día del último mes con datos reales.
	measure 'Datos al' =
			VAR c = [Índice de corte]
			VAR f = CALCULATE(MAX(Calendario[Fecha]), REMOVEFILTERS(Calendario), Calendario[indice] = c)
			RETURN FORMAT(EOMONTH(f, 0), "dd/mm/yyyy", "es-AR")
		displayFolder: 0. Período
		lineageTag: 95eccc05-ab48-4799-a9bc-dcb54e779d5c

	/// Suma del estado de resultados en pesos, en el contexto que tenga el visual.
	measure Importe = SUM(Resultado[importe_ars])
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: f0b6aad6-5ff2-449e-ba0c-abc9d9a85ada

	/// Ingreso operacional (rubro 1).
	measure Ingresos = CALCULATE([Importe], Cuenta[n1_orden] = 1)
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: aa569b2f-ada3-4753-b5ff-0db7d7caafe9

	/// Ingresos menos costos de explotación e impuestos directos. Por cartera es su margen de contribución.
	measure 'Margen bruto' = CALCULATE([Importe], Cuenta[n1_orden] <= 3)
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: 538855e7-1be8-46a8-93bd-f4a580ee6e5e

	/// Margen bruto menos gastos de estructura.
	measure 'Margen operativo' = CALCULATE([Importe], Cuenta[n1_orden] <= 4)
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: 6780b94f-8e2e-4e04-bfca-17672dcc8e99

	/// Resultado final, después del resultado no operacional y del impuesto a las ganancias.
	measure 'Utilidad neta' = CALCULATE([Importe], REMOVEFILTERS(Cuenta))
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: 9d7a6d3c-8d31-4ed5-9a85-82b6bd86259a

	/// Margen bruto sobre ingresos.
	measure 'Margen bruto %' = DIVIDE([Margen bruto], [Ingresos])
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: 6475ab77-a90d-45dd-a76c-1564e75515b1

	/// Margen operativo sobre ingresos.
	measure 'Margen operativo %' = DIVIDE([Margen operativo], [Ingresos])
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: 98b5ea8e-0a8b-4b29-bae7-a83a48c475b2

	/// Deuda que el cliente asigna para gestionar.
	measure 'Deuda asignada' = SUM(Drivers[deuda])
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: 5a2b2798-8e20-415c-bb5d-5906289d11b8

	/// Deuda cobrada: deuda asignada × % de recupero.
	measure Recuperado = SUMX(Drivers, Drivers[deuda] * Drivers[E])
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: 7b2abeb8-ad52-478d-a1d8-bcbaf34737cd

	/// Parte de la deuda asignada que se cobró, ponderada por deuda.
	measure '% recupero' = DIVIDE([Recuperado], [Deuda asignada])
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: 05c03cab-6c41-49c3-9c52-4fc57a5e8a37

	/// Comisión sobre lo recuperado, ponderada.
	measure Fee = DIVIDE(SUM(Drivers[ingreso]), SUMX(Drivers, Drivers[deuda] * Drivers[E] * Drivers[FX]))
		formatString: 0.00%
		displayFolder: 1. Base
		lineageTag: 2181552f-b922-4066-bc3b-00a4cc8bbbb4

	/// Operadores en Argentina más posiciones en Paraguay (suma de los meses del contexto).
	measure Posiciones = SUM(Drivers[ops]) + SUM(Drivers[py])
		formatString: #,##0
		displayFolder: 1. Base
		lineageTag: 7a244855-bb17-4a84-8660-28874b73097e

	/// Posiciones promedio por mes.
	measure 'Posiciones promedio' = AVERAGEX(VALUES(Calendario[indice]), [Posiciones])
		formatString: #,##0.0
		displayFolder: 1. Base
		lineageTag: 145b005a-a501-4fbf-9c4b-306c45e50fe8

	/// Horas disponibles: posiciones de cada mes × 132 horas.
	measure 'Horas de posición' = SUMX(VALUES(Calendario[indice]), [Posiciones] * 132)
		formatString: #,##0
		displayFolder: 1. Base
		lineageTag: e24ea67e-7d39-4d4c-aef1-fd825944c925

	/// Ingreso por hora de posición.
	measure 'Ingreso por hora' = DIVIDE([Ingresos], [Horas de posición])
		formatString: \$ #,##0
		displayFolder: 1. Base
		lineageTag: cff5cac0-8720-439a-9d39-03aa2fdbe66d

	/// Real del período elegido. Respeta los filtros de cartera y cuenta del visual.
	measure 'Real · período' =
			VAR d = [Índice desde]
			VAR h = [Índice hasta]
			RETURN
			    CALCULATE(
			        [Importe],
			        Escenario[esc] = "REAL",
			        REMOVEFILTERS(Calendario),
			        Calendario[indice] >= d,
			        Calendario[indice] <= h
			    )
		formatString: \$ #,##0
		displayFolder: 2. Período elegido
		lineageTag: f3ce9427-3996-4c37-ac09-67352ec38f7f

	/// Presupuesto del período elegido.
	measure 'Presupuesto · período' =
			VAR d = [Índice desde]
			VAR h = [Índice hasta]
			RETURN
			    CALCULATE(
			        [Importe],
			        Escenario[esc] = "PPTO",
			        REMOVEFILTERS(Calendario),
			        Calendario[indice] >= d,
			        Calendario[indice] <= h
			    )
		formatString: \$ #,##0
		displayFolder: 2. Período elegido
		lineageTag: da2709dc-4fd8-4906-b579-d3e93e0daae4

	/// Forecast del período elegido.
	measure 'Forecast · período' =
			VAR d = [Índice desde]
			VAR h = [Índice hasta]
			RETURN
			    CALCULATE(
			        [Importe],
			        Escenario[esc] = "FCST",
			        REMOVEFILTERS(Calendario),
			        Calendario[indice] >= d,
			        Calendario[indice] <= h
			    )
		formatString: \$ #,##0
		displayFolder: 2. Período elegido
		lineageTag: 4b289638-9fa7-4f5c-aa68-287acb4041b7

	/// Real de los mismos meses del año anterior.
	measure 'Año anterior · período' =
			VAR d = [Índice desde]
			VAR h = [Índice hasta]
			RETURN
			    CALCULATE(
			        [Importe],
			        Escenario[esc] = "REAL",
			        REMOVEFILTERS(Calendario),
			        Calendario[indice] >= d - 12,
			        Calendario[indice] <= h - 12
			    )
		formatString: \$ #,##0
		displayFolder: 2. Período elegido
		lineageTag: 097d8aa1-dd0f-4a5f-ac35-30e174807c34

	/// Real menos presupuesto. Positivo es a favor también en costos (los costos son negativos).
	measure 'Desvío vs presupuesto' = [Real · período] - [Presupuesto · período]
		formatString: \$ #,##0
		displayFolder: 2. Período elegido
		lineageTag: 5a417bb1-9284-4759-84e3-74761b12163a

	/// Desvío sobre el valor absoluto del presupuesto: positivo es mejor que lo previsto.
	measure 'Desvío vs presupuesto %' = DIVIDE([Real · período] - [Presupuesto · período], ABS([Presupuesto · período]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Período elegido
		lineageTag: 75ff868b-68f9-4d41-8281-e468b7607c8e

	/// Variación contra los mismos meses del año anterior (en pesos corrientes: incluye inflación).
	measure 'Variación vs año anterior %' = DIVIDE([Real · período] - [Año anterior · período], ABS([Año anterior · período]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Período elegido
		lineageTag: abadff78-87a6-4927-b771-f46e11076dc9

	/// Real · período en millones de pesos.
	measure 'Real · período M$' = DIVIDE([Real · período], 1000000)
		formatString: #,##0.0
		displayFolder: 2. Período elegido
		lineageTag: 030b8cb8-8054-42c5-a91d-7b34a9c81493

	/// Presupuesto · período en millones de pesos.
	measure 'Presupuesto · período M$' = DIVIDE([Presupuesto · período], 1000000)
		formatString: #,##0.0
		displayFolder: 2. Período elegido
		lineageTag: e43eebc0-40c4-4f66-9abb-acec56772164

	/// Forecast · período en millones de pesos.
	measure 'Forecast · período M$' = DIVIDE([Forecast · período], 1000000)
		formatString: #,##0.0
		displayFolder: 2. Período elegido
		lineageTag: 5b8a7c53-7c2d-4b32-a060-1603e2a25f6a

	/// Año anterior · período en millones de pesos.
	measure 'Año anterior · período M$' = DIVIDE([Año anterior · período], 1000000)
		formatString: #,##0.0
		displayFolder: 2. Período elegido
		lineageTag: e42f92d9-e6f7-4c2e-8969-46c73590a29c

	/// Desvío vs presupuesto en millones de pesos.
	measure 'Desvío vs presupuesto · período M$' = DIVIDE([Desvío vs presupuesto], 1000000)
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 2. Período elegido
		lineageTag: c65d1454-9f88-4d1c-ae3a-e39cbf5bac68

	/// Ingresos: real del período elegido.
	measure 'Ingresos · real' =
			VAR d = [Índice desde]
			VAR h = [Índice hasta]
			RETURN
			    CALCULATE(
			        [Ingresos],
			        Escenario[esc] = "REAL",
			        REMOVEFILTERS(Calendario),
			        Calendario[indice] >= d,
			        Calendario[indice] <= h
			    )
		formatString: \$ #,##0
		displayFolder: 3. Indicadores
		lineageTag: a2a0cccd-f185-4b18-a7e5-7572ff2004fd

