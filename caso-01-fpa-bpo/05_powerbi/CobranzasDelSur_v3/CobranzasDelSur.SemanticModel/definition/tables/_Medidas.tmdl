	/// Referencia de colores: real, presupuesto, forecast y año anterior.
	measure 'SVG · leyenda' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 356 40' width='356' height='40'><rect x='4' y='14' width='12' height='12' rx='2' fill='#13294B'/><text x='21' y='24' font-family='Segoe UI' font-size='11' fill='#3F4B58'>Real</text><line x1='61.4' y1='20' x2='77.4' y2='20' stroke='#98A2AE' stroke-width='2.2' stroke-dasharray='4 2.5'/><text x='82.4' y='24' font-family='Segoe UI' font-size='11' fill='#3F4B58'>Presupuesto</text><line x1='165.5' y1='20' x2='181.5' y2='20' stroke='#EB6834' stroke-width='2.2' stroke-dasharray='4 2.5'/><text x='186.5' y='24' font-family='Segoe UI' font-size='11' fill='#3F4B58'>Forecast</text><line x1='251.3' y1='20' x2='267.3' y2='20' stroke='#C5CBD3' stroke-width='2.2' stroke-dasharray='1.5 2.5' stroke-linecap='round'/><text x='272.3' y='24' font-family='Segoe UI' font-size='11' fill='#3F4B58'>Año anterior</text></svg>"
		displayFolder: 7. Imágenes SVG
