	/// Ingresos: real del mes anterior (solo en vista Mes).
	measure 'Ingresos · mes anterior' =
			VAR d = [Índice desde]
			VAR h = [Índice hasta]
			RETURN
			    IF(
			        d = h,
			        CALCULATE(
			            [Ingresos],
			            Escenario[esc] = "REAL",
			            REMOVEFILTERS(Calendario),
			            Calendario[indice] = h - 1
			        )
			    )
		formatString: \$ #,##0
		displayFolder: 3. Indicadores
		lineageTag: 43ec7e8f-081c-4af8-9a0e-9135e0436023

