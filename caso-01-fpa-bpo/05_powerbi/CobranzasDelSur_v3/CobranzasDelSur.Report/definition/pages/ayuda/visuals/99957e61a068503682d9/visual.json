                  {
                    "value": "Datos",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#13294B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Si moviste la carpeta de los CSV: Transformar datos › Editar parámetros › CarpetaDatos, y Actualizar. Para usar datos de otra empresa alcanza con reemplazar los CSV respetando las columnas.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
