			VAR _k1 = IF(ISBLANK(_r1) || ISBLANK(_c1), "#6B7682", IF(ABS(_d1) < 0.0005, "#6B7682", IF(_d1 >= 0, "#16703F", "#B42318")))
			VAR _c2 = [% recupero · real]
